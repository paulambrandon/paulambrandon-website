---
import Layout from '../layouts/Layout.astro';
import ProgramsHero from '../components/programas/ProgramsHero.astro';
import AlchemiseSection from '../components/programas/AlchemiseSection.astro';
import OffersSection from '../components/programas/OffersSection.astro';
import FitSection from '../components/programas/FitSection.astro';
import ContactCta from '../components/programas/ContactCta.astro';
import { PERSON_NAME } from '../data/site';

// Title literal de /docs/seo/paulambrandon-seo.md §8.
const title = `Programas y acompañamientos para mujeres autoexigentes | ${PERSON_NAME}`;

// El documento SEO no define meta description para /programas. En lugar de
// inventar una, se reutiliza la entradilla aprobada del propio hero.
const description =
  'Elige la forma de trabajar con Paula que mejor encaja con lo que necesitas ahora: Alchemise, Movimiento y nutrición o una Sesión de claridad.';
---

<Layout title={title} description={description}>
  <ProgramsHero />
  <AlchemiseSection />
  <OffersSection />
  <FitSection />
  <ContactCta />
</Layout>
