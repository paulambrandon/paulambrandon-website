---
import Layout from '../layouts/Layout.astro';
import {
  CONTACT_EMAIL,
  INSTAGRAM_URL,
  PERSON_NAME,
  WHATSAPP_URL,
} from '../data/site';

const title = `Contacto | ${PERSON_NAME}`;
const description =
  'Escribe a Paula Márquez Brandon para resolver dudas sobre sus programas, sesiones o colaboraciones.';
const FORMSPREE_ENDPOINT = '';
const contactFormReady = FORMSPREE_ENDPOINT.startsWith('https://formspree.io/f/');
---

<Layout title={title} description={description}>
  <section class="contact-hero" aria-labelledby="contacto-titulo">
    <div class="contact-hero__inner">
      <p class="eyebrow eyebrow--caps eyebrow--centered">Hablemos</p>
      <h1 id="contacto-titulo">Contacto</h1>
      <p class="contact-hero__lead">¿Tienes dudas antes de dar el paso?</p>
      <p class="contact-hero__text">
        No hace falta que lo tengas todo claro antes de escribir. Cuéntame
        dónde estás y te ayudo a ver qué encaja contigo.
      </p>
      <a class="button button--primary" href={WHATSAPP_URL} target="_blank" rel="noopener">
        Escribirme por WhatsApp <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section section--sand contact-page" aria-labelledby="mensaje-titulo">
    <div class="section__inner contact-page__grid">
      <aside class="contact-details">
        <p class="label label--olive">Otras formas de contactar</p>
        <h2 id="mensaje-titulo">Si lo prefieres, cuéntamelo con más calma.</h2>
        <p>
          Puedes enviarme un mensaje desde este formulario o escribirme
          directamente a través de cualquiera de estos canales.
        </p>

        <dl class="contact-details__list">
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd>
          </div>
          <div>
            <dt>Instagram</dt>
            <dd><a href={INSTAGRAM_URL} target="_blank" rel="me noopener">@paulambrandon</a></dd>
          </div>
          <div>
            <dt>¿Buscas un acompañamiento?</dt>
            <dd><a href="/programas">Ver programas <span aria-hidden="true">→</span></a></dd>
          </div>
        </dl>
      </aside>

      <form
        class="contact-form"
        action={contactFormReady ? FORMSPREE_ENDPOINT : undefined}
        method="post"
        data-contact-form
        data-contact-ready={String(contactFormReady)}
      >
        <div class="contact-form__heading">
          <p class="label label--olive">Por email</p>
          <h2>Cuéntame qué te está pasando.</h2>
        </div>

        <div class="contact-form__row">
          <label>
            <span>Nombre</span>
            <input name="name" autocomplete="name" maxlength="100" required />
          </label>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" maxlength="254" required />
          </label>
        </div>

          <label>
            <span>¿Sobre qué quieres escribirme?</span>
            <select name="subject">
              <option>Tengo dudas sobre un programa</option>
              <option>Quiero reservar una sesión</option>
              <option>Colaboraciones y otros temas</option>
            </select>
          </label>

          <label>
            <span>Cuéntame un poco más</span>
            <textarea name="message" rows="7" maxlength="5000" required></textarea>
          </label>

          <label class="visually-hidden" aria-hidden="true">
            <span>Web</span>
            <input name="_gotcha" tabindex="-1" autocomplete="off" />
          </label>

          <label class="contact-form__consent">
            <input name="consent" type="checkbox" required />
            <span>He leído y acepto la <a href="/privacidad">política de privacidad</a>.</span>
          </label>

          <button class="button button--primary" type="submit" disabled={!contactFormReady}>
            <span data-submit-label>Enviar mensaje</span> <span aria-hidden="true">→</span>
          </button>
          <p class="contact-form__help">
            {contactFormReady
              ? 'Recibirás una confirmación en pantalla cuando el mensaje se haya enviado.'
              : 'El formulario está pendiente de activar. Mientras tanto, puedes escribirme directamente por email.'}
          </p>
          <p class="contact-form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  const showStatus = (message: string, state: 'pending' | 'success' | 'error') => {
    const status = form?.querySelector<HTMLElement>('[role="status"]');
    if (!status) return;

    status.textContent = message;
    status.dataset.state = state;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;

    if (form.dataset.contactReady !== 'true') {
      showStatus('El formulario todavía no está activado. Puedes escribirme directamente por email.', 'error');
      return;
    }

    const button = form.querySelector('button[type="submit"]');
    const label = form.querySelector('[data-submit-label]');

    if (button instanceof HTMLButtonElement) {
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
    }
    if (label) label.textContent = 'Enviando…';
    showStatus('Enviando el mensaje…', 'pending');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      if (!response.ok) {
        throw new Error('No se ha podido enviar el mensaje.');
      }

      form.reset();
      showStatus('Mensaje enviado. Gracias por escribirme.', 'success');
    } catch (error) {
      const message = error instanceof Error ? error.message : 'No se ha podido enviar.';
      showStatus(`${message} También puedes escribirme directamente por email.`, 'error');
    } finally {
      if (button instanceof HTMLButtonElement) {
        button.disabled = false;
        button.removeAttribute('aria-busy');
      }
      if (label) label.textContent = 'Enviar mensaje';
    }
  });
</script>
