---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ancaResult from '../assets/images/resultado-anca-frente.webp';
import ancaBackResult from '../assets/images/resultado-anca-espalda.webp';
import estherResult from '../assets/images/resultado-esther-frente.webp';
import estherBackResult from '../assets/images/resultado-esther-espalda.webp';
import montseResult from '../assets/images/resultado-montse-frente.webp';
import montseBackResult from '../assets/images/resultado-montse-espalda.webp';
import anaResult from '../assets/images/resultado-ana.webp';
import marionResult from '../assets/images/resultado-marion.webp';
import claraResult from '../assets/images/resultado-clara.webp';
import {
  clarityTestimonials,
  movementTestimonials,
} from '../data/testimonials';
import { PERSON_NAME } from '../data/site';

const title = `Historias reales de cambio | ${PERSON_NAME}`;
const description =
  'Experiencias de mujeres que han trabajado con Paula la autoexigencia, los límites, el cuerpo, los hábitos y la relación consigo mismas.';
const results = [
  {
    name: 'Anca',
    time: '2 meses',
    images: [
      { src: ancaResult, alt: 'Evolución física de Anca vista de frente, antes y después' },
      { src: ancaBackResult, alt: 'Evolución física de Anca vista de espalda, antes y después' },
    ],
  },
  {
    name: 'Esther',
    time: '6 meses',
    images: [
      { src: estherResult, alt: 'Evolución física de Esther vista de frente, antes y después' },
      { src: estherBackResult, alt: 'Evolución física de Esther vista de espalda, antes y después' },
    ],
  },
  {
    name: 'Montse',
    time: '2 meses',
    images: [
      { src: montseResult, alt: 'Evolución física de Montse vista de frente, antes y después' },
      { src: montseBackResult, alt: 'Evolución física de Montse vista de espalda, antes y después' },
    ],
  },
  {
    name: 'Ana',
    time: '5 meses',
    images: [{ src: anaResult, alt: 'Evolución física de Ana vista de espalda, antes y después' }],
  },
  {
    name: 'Marion',
    time: '3 meses',
    images: [{ src: marionResult, alt: 'Evolución física de Marion vista de espalda, antes y después' }],
  },
  {
    name: 'Clara',
    time: '1 mes',
    images: [{ src: claraResult, alt: 'Evolución física de Clara vista de perfil, antes y después' }],
  },
] as const;
const testimonials = [
  clarityTestimonials[0],
  clarityTestimonials[1],
  movementTestimonials[0],
  clarityTestimonials[2],
  movementTestimonials[1],
  movementTestimonials[2],
  movementTestimonials[3],
  movementTestimonials[4],
] as const;
---

<Layout title={title} description={description}>
  <section class="section section--sand testimonials-page" aria-labelledby="testimonios-titulo">
    <div class="section__inner">
      <header class="testimonials-page__header">
        <p class="eyebrow eyebrow--caps eyebrow--centered">Testimonios</p>
        <h1 id="testimonios-titulo">Historias de mujeres que han vivido el proceso</h1>
        <p>
          No todas llegaron desde el mismo lugar ni necesitaban trabajar lo
          mismo. Estas son algunas de sus experiencias.
        </p>
      </header>

      <div class="testimonials-page__grid">
        {testimonials.map(({ quote, highlightedQuote, author, program }) => (
          <figure class="testimonial-card">
            <blockquote>
              <p set:html={highlightedQuote ?? quote} />
            </blockquote>
            <figcaption>
              <span class="testimonial-card__name">{author}</span>
              <span class="testimonial-card__tag">{program}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper physical-results">
    <div class="section__inner">
      <header class="physical-results__intro">
        <h2>Cambios físicos</h2>
        <p>El cambio de fuera también cuenta, cuando llega desde un lugar sano.</p>
      </header>
      <div class="physical-results__grid">
        {results.map(({ images, name, time }) => (
          <figure class="physical-result">
            <div class="physical-result__media">
              {images.map(({ src, alt }) => (
                <Image src={src} alt={alt} widths={[400, 800]} sizes="(min-width: 64rem) 21rem, (min-width: 40rem) 42vw, calc(100vw - 4.25rem)" loading="lazy" />
              ))}
            </div>
            <figcaption>
              <span class="physical-result__time">{time}</span>
              <span class="physical-result__name">{name}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--olive testimony-final">
    <div class="section__inner">
      <p class="lead-italic">No se trata de convertirte en otra mujer.</p>
      <h2>Tu proceso no tiene por qué parecerse al de ninguna de ellas.</h2>
      <p>Conoce las distintas formas de trabajar conmigo y descubre cuál puede encajar con el momento en el que estás.</p>
      <div class="testimony-final__actions">
        <a class="button button--light" href="/programas">Ver programas →</a>
        <a class="button button--outline-light" href="/contacto">Contactar</a>
      </div>
    </div>
  </section>
</Layout>
