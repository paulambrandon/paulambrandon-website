---
import Layout from '../layouts/Layout.astro';
import MethodHero from '../components/metodo/MethodHero.astro';
import RootSection from '../components/metodo/RootSection.astro';
import ProcessSection from '../components/metodo/ProcessSection.astro';
import HowIAccompanySection from '../components/metodo/HowIAccompanySection.astro';
import GrowthSection from '../components/metodo/GrowthSection.astro';
import ShiftSection from '../components/metodo/ShiftSection.astro';
import ProgramsCta from '../components/metodo/ProgramsCta.astro';
import { PERSON_NAME } from '../data/site';
import { methodDescription } from '../data/metodo';

const title = `Mi método: de la autoexigencia al autocuidado | ${PERSON_NAME}`;
---

<Layout title={title} description={methodDescription} bodyClass="page-method"
  fontPreloads={['/fonts/CormorantGaramond.woff2', '/fonts/Inter.woff2']}>
  <MethodHero />
  <RootSection />
  <ProcessSection />
  <HowIAccompanySection />
  <GrowthSection />
  <ShiftSection />
  <ProgramsCta />
</Layout>
