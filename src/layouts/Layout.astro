---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getRouteSeo } from '../data/seo';
import { PERSON_NAME } from '../data/site';
import '../sass/main.scss';

interface Props {
  /** Contenido completo de <title>. */
  title: string;
  /** Meta description de la página. */
  description: string;
  bodyClass?: string;
  /** Ruta absoluta u relativa a un og:image específico; por defecto, el retrato compartido. */
  ogImage?: string;
  /** Descripción accesible de la imagen social. */
  ogImageAlt?: string;
  /** Excluye páginas utilitarias o de error del índice sin bloquear sus enlaces. */
  noindex?: boolean;
}

const {
  title,
  description,
  bodyClass,
  ogImage: suppliedOgImage,
  ogImageAlt: suppliedOgImageAlt,
  noindex = false,
} = Astro.props;

// El dominio canónico sale solo de `Astro.site` (astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const currentRouteSeo = getRouteSeo(Astro.url.pathname);
const breadcrumbs = currentRouteSeo?.breadcrumbs ?? [];
const ogImage = suppliedOgImage ?? currentRouteSeo?.ogImage ?? '/og/default.jpg';
const ogImageAlt =
  suppliedOgImageAlt ??
  currentRouteSeo?.ogImageAlt ??
  'Retrato de Paula Márquez Brandon';
const ogImageUrl = new URL(ogImage, Astro.site).href;
const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map(({ label, href }, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: label,
        item: new URL(href, Astro.site).href,
      })),
    }
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PERSON_NAME} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/favicon/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <link rel="preload" href="/fonts/Inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/CormorantGaramond.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />
    {breadcrumbSchema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbSchema)}
      />
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const easeOut = getComputedStyle(document.documentElement)
        .getPropertyValue('--ease-out')
        .trim();

      const transformation = document.querySelector<HTMLElement>(
        '[data-motion="transformation"]',
      );
      const methodOrigin = document.querySelector<HTMLElement>(
        '[data-motion="method-origin"]',
      );
      const editorialReveals = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal]'),
      );

      methodOrigin?.setAttribute('data-motion-ready', '');
      editorialReveals.forEach((element) => {
        element.setAttribute('data-reveal-ready', '');
      });

      const revealEditorial = (element: HTMLElement) => {
        element.setAttribute('data-reveal-visible', '');
      };

      const revealTransformation = () => {
        if (!transformation || reduceMotion) return;

        transformation.querySelectorAll<HTMLElement>('.transformation__row').forEach((row, index) => {
          const after = row.querySelector<HTMLElement>('.transformation__cell:last-child');
          const arrow = row.querySelector<HTMLElement>('.transformation__arrow');
          const keyframes = [
            { transform: 'translateX(-0.375rem)' },
            { transform: 'translateX(0)' },
          ];
          const options: KeyframeAnimationOptions = {
            duration: 280,
            delay: index * 60,
            easing: easeOut,
            fill: 'both',
          };

          after?.animate(keyframes, options);
          arrow?.animate(keyframes, options);
        });
      };

      const revealMethodOrigin = () => {
        methodOrigin?.setAttribute('data-motion-visible', '');
      };

      const targets: { element: HTMLElement; reveal: () => void }[] = [
        ...editorialReveals.map((element) => ({
          element,
          reveal: () => revealEditorial(element),
        })),
        transformation && { element: transformation, reveal: revealTransformation },
        methodOrigin && { element: methodOrigin, reveal: revealMethodOrigin },
      ].filter((target): target is { element: HTMLElement; reveal: () => void } => Boolean(target));

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const target = targets.find(({ element }) => element === entry.target);
              target?.reveal();
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.25, rootMargin: '0px 0px -10% 0px' },
        );

        targets.forEach(({ element }) => observer.observe(element));
      } else {
        targets.forEach(({ reveal }) => reveal());
      }
    </script>
  </body>
</html>
