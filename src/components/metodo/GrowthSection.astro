---
import { approach } from '../../data/metodo';
---

<section class="section section--paper method-approach" aria-labelledby="enfoque-titulo">
  <div class="section__inner method-approach__inner">
    <header class="method-approach__header">
      <p class="eyebrow">Qué hace diferente este enfoque</p>
      <h2 id="enfoque-titulo">Crecer sin tratarte como <em>un problema que hay que corregir.</em></h2>
    </header>
    <ul class="method-approach__list">
      {approach.map(({ title, text }) => (
        <li><h3>{title}</h3><p>{text}</p></li>
      ))}
    </ul>
  </div>
</section>
