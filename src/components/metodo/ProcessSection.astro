---
import { methodStages } from '../../data/metodo';
---

<section class="section section--paper method-stages" id="etapas" aria-labelledby="etapas-titulo">
  <div class="section__inner">
    <header class="method-stages__header">
      <p class="eyebrow">El proceso</p>
      <h2 id="etapas-titulo">Tres etapas para cambiar desde otro lugar.</h2>
      <p>Entender lo que ocurre, transformar la relación contigo y llevarlo a tu vida.</p>
    </header>
    <ol class="method-stages__list">
      {methodStages.map(({ title, intro, description }, index) => (
        <li class="method-stage">
          <span class="method-stage__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div class="method-stage__copy">
            <h3>{title}</h3>
            <p class="method-stage__intro">{intro}</p>
            <p>{description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
