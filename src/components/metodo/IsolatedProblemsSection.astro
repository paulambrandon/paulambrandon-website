---
import { isolatedAreas } from '../../data/metodo';
---

<section class="section section--sand isolated" id="no-aislados">
  <div class="section__inner">
    <h2 class="section__title isolated__title">
      Puede parecer que son problemas diferentes.
    </h2>

    <ul class="isolated__areas">
      {isolatedAreas.map((area) => <li class="isolated__area">{area}</li>)}
    </ul>

    <div class="rule-drop isolated__rule" aria-hidden="true"></div>

    <div class="isolated__statement">
      <p class="isolated__claim">
        TAL Y COMO SOY, <span class="isolated__accent">NO BASTA.</span>
      </p>
    </div>
  </div>
</section>
