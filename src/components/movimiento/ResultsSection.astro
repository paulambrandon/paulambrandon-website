---
import { Image } from 'astro:assets';
import result01 from '../../assets/images/placeholder-resultado-01.jpg';
import result02 from '../../assets/images/placeholder-resultado-02.jpg';
import result03 from '../../assets/images/placeholder-resultado-03.jpg';
import { resultsNote } from '../../data/movimiento-nutricion';

// TODO: pendientes las fotografías reales de resultados, con autorización
// expresa de cada mujer antes de publicarlas.
const results = [result01, result02, result03];
---

<section class="section section--sand results">
  <div class="section__inner">
    <h2 class="results__title">
      El cambio de fuera también cuenta — cuando llega desde un lugar sano.
    </h2>
    <p class="lead-italic">{resultsNote}</p>

    <div class="results__grid">
      {
        results.map((image, index) => (
          <Image
            class="results__image"
            src={image}
            alt={`Espacio reservado para una fotografía real de resultados, pendiente de publicar con el consentimiento expreso de la clienta (${index + 1} de ${results.length})`}
            widths={[300, 450, 900]}
            sizes="(min-width: 48rem) 30vw, calc(100vw - 2.75rem)"
            loading="lazy"
          />
        ))
      }
    </div>
  </div>
</section>
