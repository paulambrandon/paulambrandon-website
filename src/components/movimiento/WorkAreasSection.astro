---
import { workAreas, workFormula, workStatement } from '../../data/movimiento-nutricion';
---

<section class="section section--sand work" id="trabajamos">
  <div class="section__inner">
    <h2 class="section__title work__title">Qué trabajamos</h2>

    <div class="work__grid">
      {
        workAreas.map(({ title, text }) => (
          <article class="work__area">
            <h3 class="work__area-title">{title}</h3>
            <p class="work__text">{text}</p>
          </article>
        ))
      }
    </div>

    <div class="work__closing">
      <p class="work__statement">{workStatement}</p>
      <p class="label label--olive work__formula">{workFormula}</p>
    </div>
  </div>
</section>
