---
import { outcomes } from '../../data/movimiento-nutricion';
---

<section class="section section--olive outcomes">
  <div class="section__inner">
    <h2 class="section__title outcomes__title">
      Hay cambios que se ven. Y otros que cambian cómo vives el proceso.
    </h2>

    <div class="outcomes__grid">
      {
        outcomes.map(({ title, text }) => (
          <div class="outcomes__item">
            <h3 class="label label--sage outcomes__label">{title}</h3>
            <p class="outcomes__text">{text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
