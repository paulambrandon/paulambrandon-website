---
import { featuredTestimonial, testimonials } from '../../data/movimiento-nutricion';
---

<section class="section section--paper voices">
  <div class="section__inner">
    <h2 class="section__title">
      Lo que cambia cuando puedes sostener el proceso
    </h2>

    <blockquote class="voices__featured">
      <p class="voices__featured-quote">{featuredTestimonial}</p>
    </blockquote>

    <div class="voices__grid voices__grid--pair">
      {
        testimonials.map((quote) => (
          <blockquote>
            <p class="voices__quote">{quote}</p>
          </blockquote>
        ))
      }
    </div>

    <p class="testimonials__cta">
      <a class="link-arrow" href="/testimonios">
        Ver más historias <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
