---
import SpecList from '../landing/SpecList.astro';
import { request, requestHref } from '../../data/movimiento-nutricion';
---

<section class="section section--olive invest" id="solicitar">
  <div class="section__inner">
    <h2 class="invest__title">¿Quieres trabajar esto conmigo?</h2>

    <SpecList rows={request} olive class="invest__spec" />

    <p>
      <a class="button button--light" href={requestHref}>
        Solicitar acompañamiento <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
