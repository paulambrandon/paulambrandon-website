---
import { BRAND, mainNav } from '../../data/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">{BRAND}</a>

    <button
      class="site-header__toggle"
      type="button"
      aria-label="Menú"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-toggle
    >
      <span class="site-header__burger" aria-hidden="true"></span>
    </button>

    <nav class="site-header__nav" id="menu-principal" aria-label="Principal">
      <ul class="main-nav">
        {
          mainNav.map(({ label, href }) => (
            <li class="main-nav__item">
              <a
                class="main-nav__link"
                href={href}
                aria-current={currentPath === href ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('site-header--open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
