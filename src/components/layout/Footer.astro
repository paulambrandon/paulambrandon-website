---
import { BRAND, PERSON_NAME, legalNav, mainNav, socialNav } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__brand">{BRAND}</p>
    <p class="site-footer__copyright">© {year} {PERSON_NAME}</p>

    <nav class="site-footer__nav" aria-label="Pie de página">
      <ul class="site-footer__list">
        {
          mainNav.map(({ label, href }) => (
            <li>
              <a class="site-footer__link" href={href}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      socialNav.length > 0 && (
        <nav class="site-footer__nav" aria-label="Redes sociales">
          <ul class="site-footer__list site-footer__list--inline">
            {socialNav.map(({ label, href }) => (
              <li>
                <a class="site-footer__link" href={href} rel="me noopener">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav class="site-footer__nav" aria-label="Información legal">
      <ul class="site-footer__list site-footer__list--inline site-footer__list--legal">
        {
          legalNav.map(({ label, href }) => (
            <li>
              <a class="site-footer__link site-footer__link--legal" href={href}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
