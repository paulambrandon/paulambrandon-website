---
import { BRAND, PERSON_NAME, legalNav, mainNav, socialNav } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__identity">
      <a class="site-footer__brand" href="/" aria-label={`${BRAND} — Inicio`}>{BRAND}</a>
      <p class="site-footer__copyright">© {year} {PERSON_NAME}</p>
    </div>

    <nav class="site-footer__nav" aria-labelledby="footer-web-title">
      <h2 class="site-footer__title" id="footer-web-title">Navegación</h2>
      <ul class="site-footer__list">
        {
          mainNav.map(({ label, href }) => (
            <li>
              <a class="site-footer__link" href={href}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      socialNav.length > 0 && (
        <nav class="site-footer__nav" aria-labelledby="footer-social-title">
          <h2 class="site-footer__title" id="footer-social-title">Redes sociales</h2>
          <ul class="site-footer__list site-footer__list--inline">
            {socialNav.map(({ label, href }) => (
              <li>
                <a class="site-footer__link" href={href} rel="me noopener">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav class="site-footer__nav site-footer__nav--legal" aria-label="Información legal">
      <ul class="site-footer__list site-footer__list--inline site-footer__list--legal">
        {
          legalNav.map(({ label, href }) => (
            <li>
              <a class="site-footer__link site-footer__link--legal" href={href}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
