---
import { Image } from 'astro:assets';
import heroPortrait from '../../assets/images/paula-marquez-brandon.webp';
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__text">
      <p class="eyebrow">No necesitas convertirte en otra mujer.</p>
      <h1 class="hero__title">
        Necesitas dejar de construir tu vida alrededor de la idea de que no eres
        suficiente.
      </h1>
      <a class="button button--primary hero__cta" href="#el-problema">
        Descubre qué hay realmente detrás <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="hero__media">
      <div class="hero__frame">
        <Image
          class="hero__image"
          src={heroPortrait}
          alt="Paula Márquez Brandon, retrato"
          format="avif"
          quality={60}
          widths={[220, 300, 400, 440, 600, 760, 900]}
          sizes="(min-width: 53.8125rem) 300px, (min-width: 40.0625rem) 380px, min(58vw, 220px)"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
