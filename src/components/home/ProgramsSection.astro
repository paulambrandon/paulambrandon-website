---
import { featuredProgram, secondaryPrograms } from '../../data/home';
---

<section class="section section--sand programs">
  <div class="section__inner">
    <h2 class="section__title" data-reveal>Formas de trabajar conmigo</h2>

    <div class="programs__grid" data-reveal data-reveal-delay="80">
      <article class="program program--featured">
        <div class="program__cover" aria-hidden="true">
          <span>Alchemise</span>
          <small>90 días</small>
        </div>
        <div class="program__body">
          <h3 class="program__title">{featuredProgram.title}</h3>
          <p class="program__text">{featuredProgram.description}</p>
        </div>
        <a class="link-arrow" href={featuredProgram.href}>
          {featuredProgram.linkLabel} <span aria-hidden="true">→</span>
        </a>
      </article>

      <div class="programs__secondary">
        {
          secondaryPrograms.map(({ title, description, href, linkLabel }) => (
            <article class="program">
              <h3 class="program__title program__title--sm">{title}</h3>
              <p class="program__text">{description}</p>
              <a class="link-arrow" href={href}>
                {linkLabel} <span class="visually-hidden">{title}</span>{' '}
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>

    <p class="programs__cta" data-reveal data-reveal-delay="160">
      <a class="button button--secondary" href="/programas">
        Ver programas <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
