---
import { featuredTestimonials } from '../../data/testimonials';
---

<section class="section section--sand testimonials">
  <div class="section__inner">
    <h2 class="section__title">Mujeres que ya han hecho este proceso</h2>

    <div class="testimonials__list">
      {
        featuredTestimonials.map(({ quote, author, program }) => (
          <figure class="testimonial">
            <blockquote class="testimonial__quote">
              <p>{quote}</p>
            </blockquote>
            <figcaption class="testimonial__author">
              <span>{author}</span>
              <span class="label">{program}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="testimonials__cta">
      <a class="button button--secondary" href="/testimonios">
        Ver testimonios <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
