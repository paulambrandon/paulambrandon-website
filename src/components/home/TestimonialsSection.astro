---
import { alchemiseTestimonials } from '../../data/testimonials';

const homeTestimonials = [alchemiseTestimonials[0], alchemiseTestimonials[2]];
---

<section class="section section--olive testimonials">
  <div class="section__inner">
    <header class="testimonials__header">
      <p class="label label--sage">Testimonios</p>
      <h2>Mujeres que ya han hecho este proceso</h2>
    </header>

    <div class="testimonials__list testimonials__list--home">
      {
        homeTestimonials.map(({ quote, author }) => (
          <figure class="testimonial testimonial--home">
            <blockquote class="testimonial__quote">
              <p>{quote}</p>
            </blockquote>
            <figcaption class="testimonial__author">
              <span>{author}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="testimonials__cta">
      <a class="testimonials__link" href="/testimonios">
        Ver testimonios <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
