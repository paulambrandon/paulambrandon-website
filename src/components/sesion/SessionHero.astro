---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/placeholder-sesion-hero.jpg';
import { bookingHref, heroLede, heroNote } from '../../data/sesion-claridad';

// A diferencia de las otras dos landings, este hero es centrado y el retrato
// va debajo, no en una segunda columna.
---

<section class="session-hero">
  <div class="session-hero__inner">
    <p class="eyebrow eyebrow--caps eyebrow--centered session-hero__eyebrow">
      Sesión individual
    </p>

    <h1 class="session-hero__title">Sesión de claridad</h1>

    <p class="session-hero__lede">{heroLede}</p>

    <p>
      <a class="button button--primary" href={bookingHref}>
        Reservar sesión <span aria-hidden="true">→</span>
      </a>
    </p>
    <p class="landing-hero__note">{heroNote}</p>

    <div class="session-hero__media">
      <Image
        class="session-hero__image"
        src={heroImage}
        alt="Espacio reservado para la fotografía de Paula Márquez Brandon durante una sesión de claridad (pendiente)"
        widths={[400, 600, 900, 1200]}
        sizes="min(27.5rem, calc(100vw - 2.75rem))"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
