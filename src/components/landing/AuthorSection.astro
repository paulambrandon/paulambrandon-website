---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  readonly image: ImageMetadata;
  readonly imageAlt: string;
  readonly label: string;
  readonly text: string;
  readonly credentials?: string;
  readonly linkHref?: string;
  readonly linkLabel?: string;
}

const { image, imageAlt, label, text, credentials, linkHref, linkLabel } =
  Astro.props;
---

<div class="author">
  <div class="author__media">
    <Image
      class="author__image"
      src={image}
      alt={imageAlt}
      widths={[400, 600, 900, 1200]}
      sizes="(min-width: 64rem) 30vw, min(24rem, calc(100vw - 2.75rem))"
      loading="lazy"
    />
  </div>

  <div>
    <p class="label author__label">{label}</p>
    <p class="author__text">{text}</p>
    {credentials && <p class="author__credentials">{credentials}</p>}
    {
      linkHref && linkLabel && (
        <a class="link-arrow" href={linkHref}>
          {linkLabel} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</div>
