---
interface Props {
  readonly items: readonly string[];
  /** A dos columnas el DOM se reparte por columnas: los primeros a la izquierda. */
  readonly columns?: 1 | 2;
  readonly class?: string;
}

const { items, columns = 1, class: className } = Astro.props;
---

<ul
  class:list={[
    'claim-list',
    columns === 2 && 'claim-list--two',
    className,
  ]}
>
  {items.map((item) => <li class="claim-list__item">{item}</li>)}
</ul>
