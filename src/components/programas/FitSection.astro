---
import { fitRows } from '../../data/programas';
---

<section class="section section--sand fit" aria-labelledby="comparador-titulo">
  <div class="section__inner">
    <div class="fit__heading">
      <p class="eyebrow eyebrow--caps eyebrow--centered">Una orientación rápida</p>
      <h2 id="comparador-titulo">Encuentra tu punto de partida.</h2>
    </div>

    <dl class="fit__list">
      {
        fitRows.map(({ need, program, href }) => (
          <div class="fit__row">
            <dt>{need}</dt>
            <dd><a href={href}>{program} <span aria-hidden="true">→</span></a></dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
