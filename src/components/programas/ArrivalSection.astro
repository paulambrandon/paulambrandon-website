---
import { arrivalQuotes } from '../../data/programas';
---

<section class="section section--sand arrival" id="orientacion">
  <div class="section__inner">
    <h2 class="section__title arrival__title">
      No necesitas saber exactamente qué necesitas para empezar.
    </h2>

    <div class="arrival__body">
      <p class="arrival__label">Puedes llegar diciendo…</p>

      <ul>
        {
          arrivalQuotes.map((quote) => (
            <li class="arrival__item">
              <p class="arrival__quote">{quote}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
