---
import { Image } from 'astro:assets';
import { offers } from '../../data/programas';
---

<section class="offers">
  <div class="offers__grid">
    {
      offers.map(
        ({ kicker, title, meta, description, note, href, linkLabel, image, imageAlt }) => (
          <article class="offer">
            <p class="label label--olive offer__kicker">{kicker}</p>
            <h2 class="offer__title">{title}</h2>

            {meta && <p class="offer__meta">{meta}</p>}

            {image && (
              <Image
                class="offer__image"
                src={image}
                alt={imageAlt ?? ''}
                widths={[400, 600, 900, 1200]}
                sizes="(min-width: 64rem) 40vw, (min-width: 48rem) 36rem, calc(100vw - 2.75rem)"
                loading="lazy"
              />
            )}

            <p class="offer__text">{description}</p>
            <p class="lead-italic offer__note">{note}</p>

            <a class="link-arrow" href={href}>
              {linkLabel} <span aria-hidden="true">→</span>
            </a>
          </article>
        ),
      )
    }
  </div>
</section>
