---
import { programTestimonials } from '../../data/programas';
---

<section class="section section--paper">
  <div class="section__inner">
    <div class="pair-quotes">
      {
        programTestimonials.map((quote) => (
          <blockquote class="pair-quotes__item testimonial__quote">
            <p>{quote}</p>
          </blockquote>
        ))
      }
    </div>

    <p class="testimonials__cta">
      <a class="link-arrow" href="/testimonios">
        Ver testimonios <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
