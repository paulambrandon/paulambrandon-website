---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/placeholder-alchemise-hero.jpg';
import {
  editionCta,
  editionStatus,
  heroLede,
  heroNote,
  heroSubtitle,
} from '../../data/alchemise';
---

<section class="landing-hero alchemise-hero">
  <div class="landing-hero__inner">
    <div class="landing-hero__grid">
      <div class="landing-hero__head">
        <p class="badge badge--accent landing-hero__kicker">{editionStatus}</p>
        <h1 class="alchemise-hero__title">Alchemise</h1>
        <p class="alchemise-hero__subtitle">{heroSubtitle}</p>
        <p class="landing-hero__lede">{heroLede}</p>
      </div>

      <div class="landing-hero__media">
        <div class="landing-hero__frame">
          <Image
            class="landing-hero__image"
            src={heroImage}
            alt="Paula Márquez Brandon acompañando una edición de Alchemise"
            widths={[400, 600, 900, 1200]}
            sizes="(min-width: 64rem) 38vw, min(24rem, calc(100vw - 2.75rem))"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="landing-hero__actions">
        <p>
          <a class="button button--primary" href="#inversion">
            {editionCta} <span aria-hidden="true">→</span>
          </a>
        </p>
        <p class="landing-hero__note">{heroNote}</p>
      </div>
    </div>
  </div>
</section>
