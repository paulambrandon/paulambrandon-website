---
import SpecList from '../landing/SpecList.astro';
import {
  editionCta,
  editionStatus,
  investment,
  signupHref,
} from '../../data/alchemise';
---

<section class="section section--olive invest" id="inversion">
  <div class="section__inner">
    <p class="badge badge--sage invest__badge">{editionStatus}</p>
    <h2 class="invest__title">Tu plaza en Alchemise</h2>

    <SpecList rows={investment} olive class="invest__spec" />

    <p>
      <a class="button button--light" href={signupHref}>
        {editionCta} <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
