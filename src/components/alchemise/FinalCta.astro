---
import { editionCta, editionStatus } from '../../data/alchemise';
---

<section class="section section--sand section--spacious final-cta">
  <div class="section__inner">
    <p class="badge badge--accent final-cta__badge">{editionStatus}</p>

    <h2 class="final-cta__title">
      Empezar este proceso también es una forma de elegirte.
    </h2>

    <p class="final-cta__action">
      <a class="button button--primary" href="#inversion">
        {editionCta} <span aria-hidden="true">→</span>
      </a>
    </p>

    <p class="final-cta__link">
      <a class="link-arrow" href="/contacto">
        ¿Tienes dudas? Contacta conmigo <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
